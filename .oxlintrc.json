{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [".agents/**"],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn"
  },
  "rules": {
    "eslint/no-control-regex": "off",
    "eslint/no-underscore-dangle": ["warn", { "allow": ["_meta", "_repoPath", "__dirname"] }]
  }
}
