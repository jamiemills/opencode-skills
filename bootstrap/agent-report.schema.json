{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentskills.io/schemas/csm-agent-report-1.json",
  "title": "Universal Agent Skills bootstrap agent report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "protocol", "result", "exitCode", "states", "capabilities", "availability", "limitations"],
  "properties": {
    "schema": { "const": "csm-agent-report/1" },
    "protocol": { "const": "csm-skills-bootstrap/1" },
    "result": { "enum": ["placed", "refused"] },
    "exitCode": { "type": "integer", "minimum": 0, "maximum": 13 },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "state"],
      "properties": {
        "code": {
          "enum": [
            "E_NO_NPX",
            "E_NO_WRITE",
            "E_NO_DESTINATION",
            "E_AMBIGUOUS_DESTINATION",
            "E_UNTRUSTED",
            "E_UNSUPPORTED_FORMAT",
            "E_MALICIOUS_STEPS",
            "E_DESTINATION_SYMLINK",
            "E_TRAVERSAL",
            "E_DUPLICATE",
            "E_MODIFIED_EXISTING",
            "E_HASH_MISMATCH",
            "E_INTERRUPTED"
          ]
        },
        "state": {
          "enum": ["DISCOVER", "TRUST", "PLAN_DESTINATION", "CONFIRM_IF_NEEDED", "MATERIALIZE", "VERIFY", "REPORT"]
        }
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "action"],
        "properties": {
          "state": {
            "enum": ["DISCOVER", "TRUST", "PLAN_DESTINATION", "CONFIRM_IF_NEEDED", "MATERIALIZE", "VERIFY", "REPORT"]
          },
          "action": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
          "refusal": {
            "enum": [
              null,
              "E_NO_NPX",
              "E_NO_WRITE",
              "E_NO_DESTINATION",
              "E_AMBIGUOUS_DESTINATION",
              "E_UNTRUSTED",
              "E_UNSUPPORTED_FORMAT",
              "E_MALICIOUS_STEPS",
              "E_DESTINATION_SYMLINK",
              "E_TRAVERSAL",
              "E_DUPLICATE",
              "E_MODIFIED_EXISTING",
              "E_HASH_MISMATCH",
              "E_INTERRUPTED"
            ]
          }
        }
      }
    },
    "destination": { "type": ["string", "null"], "pattern": "^/" },
    "skillsPlaced": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "filesPlaced": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes", "verified"],
        "properties": {
          "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._/-]*$", "maxLength": 256 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "verified": { "const": true }
        }
      }
    },
    "hashVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "verified", "total"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "verified": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "reloadAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "action"],
      "properties": {
        "status": { "enum": ["declared", "unknown"] },
        "action": { "type": ["string", "null"], "minLength": 1, "maxLength": 256 }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hasNpx", "hasFileWrite", "knowsDestination", "supportsStaging", "supportsLock", "supportsRollback", "knowsReload"],
      "properties": {
        "hasNpx": { "type": "boolean" },
        "hasFileWrite": { "type": "boolean" },
        "knowsDestination": { "type": "boolean" },
        "supportsStaging": { "type": "boolean" },
        "supportsLock": { "type": "boolean" },
        "supportsRollback": { "type": "boolean" },
        "knowsReload": { "type": "boolean" }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["staging", "locking", "rollback"],
      "properties": {
        "staging": { "type": "boolean" },
        "locking": { "type": "boolean" },
        "rollback": { "type": "boolean" }
      }
    },
    "backupPath": { "type": ["string", "null"], "pattern": "^/" },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "result": { "const": "refused" } }, "required": ["result"] },
      "then": {
        "required": ["refusal", "destination"],
        "properties": { "exitCode": { "minimum": 1 }, "destination": { "type": "null" } }
      }
    },
    {
      "if": { "properties": { "result": { "const": "placed" } }, "required": ["result"] },
      "then": {
        "required": ["destination", "skillsPlaced", "filesPlaced", "hashVerification", "reloadAction"],
        "properties": {
          "exitCode": { "const": 0 },
          "refusal": { "type": "null" },
          "destination": { "type": "string" },
          "hashVerification": { "properties": { "total": { "minimum": 1 } } }
        }
      }
    }
  ]
}
