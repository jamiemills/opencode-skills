{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "csm-skill-progress/1",
  "title": "CSM skill invocation progress record",
  "description": "A per-invocation milestone record for the skill-level TASK PROGRESS tracker. Evidence of invocation state; never an execution cursor or a substitute for plan/build state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "progressId",
    "runId",
    "skill",
    "goal",
    "status",
    "overallPercent",
    "milestones",
    "startedAt",
    "updatedAt"
  ],
  "properties": {
    "schema": { "const": "csm-skill-progress/1" },
    "progressId": { "type": "string", "pattern": "^progress-[a-z0-9][a-z0-9-]{1,127}$" },
    "runId": { "type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{1,127}$" },
    "skill": { "type": "string", "pattern": "^csm-[a-z0-9][a-z0-9-]{1,63}$" },
    "goal": { "type": "string", "minLength": 1, "maxLength": 300 },
    "status": { "enum": ["active", "complete", "blocked", "paused"] },
    "overallPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
    "milestones": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "weightPercent", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^M[0-9]{1,3}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "weightPercent": { "type": "integer", "minimum": 1, "maximum": 100 },
          "status": { "enum": ["complete", "active", "pending"] },
          "verifiedFraction": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
