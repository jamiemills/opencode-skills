{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "csm-trace/1",
  "title": "CSM deterministic redacted evaluation trace",
  "description": "A bounded, reproducible trace. Prompts, secrets, and complete tool results are intentionally not representable.",
  "type": "object",
  "required": [
    "schema",
    "traceId",
    "runId",
    "manifest",
    "outcome",
    "events",
    "artifacts",
    "reproducibility",
    "redaction"
  ],
  "properties": {
    "schema": { "const": "csm-trace/1" },
    "traceId": { "type": "string", "pattern": "^tr-[a-z0-9-]+$" },
    "runId": { "type": "string", "pattern": "^run-[a-z0-9-]+$" },
    "manifest": {
      "type": "object",
      "required": ["schema", "version", "contentDigest"],
      "properties": {
        "schema": { "const": "csm-skill-manifest/1" },
        "version": { "const": 1 },
        "contentDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "outcome": {
      "enum": [
        "activation",
        "trajectory",
        "refusal",
        "recovery",
        "artifact-correctness",
        "reproducibility"
      ]
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["eventId", "sequence", "type", "status"],
        "properties": {
          "eventId": { "type": "string", "pattern": "^ev-[a-z0-9-]+$" },
          "sequence": { "type": "integer", "minimum": 0 },
          "type": { "enum": ["activation", "trajectory", "refusal", "recovery"] },
          "status": { "enum": ["started", "completed", "refused", "recovered"] },
          "inputDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "toolName": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
          "toolResultDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "errorCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]+$" }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["artifactId", "kind", "sha256", "producedByEventId"],
        "properties": {
          "artifactId": { "type": "string", "pattern": "^art-[a-z0-9-]+$" },
          "kind": { "enum": ["evaluation-result", "trace", "report"] },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "producedByEventId": { "type": "string", "pattern": "^ev-[a-z0-9-]+$" }
        },
        "additionalProperties": false
      }
    },
    "reproducibility": {
      "type": "object",
      "required": ["fixtureId", "seed", "deterministic"],
      "properties": {
        "fixtureId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "seed": { "type": "string", "minLength": 1 },
        "deterministic": { "const": true }
      },
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "required": ["mode", "omitted"],
      "properties": {
        "mode": { "const": "default-deny" },
        "omitted": {
          "type": "array",
          "items": { "enum": ["raw-prompt", "secrets", "full-tool-results"] },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
