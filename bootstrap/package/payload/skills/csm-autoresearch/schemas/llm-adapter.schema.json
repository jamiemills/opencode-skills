{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "provider-neutral csm-autoresearch LLM adapter",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "adapterId", "kind", "mode", "limits", "request", "response"],
  "properties": {
    "format": { "const": "csm-autoresearch-llm-adapter/1" },
    "adapterId": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["proposer", "judge"] },
    "mode": { "enum": ["stub", "live"] },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxInputBytes", "maxOutputBytes", "timeoutMs"],
      "properties": {
        "maxInputBytes": { "type": "integer", "minimum": 1, "maximum": 10485760 },
        "maxOutputBytes": { "type": "integer", "minimum": 1, "maximum": 10485760 },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "maxProposals": { "type": "integer", "minimum": 1, "maximum": 50 }
      }
    },
    "request": {
      "type": "object",
      "required": ["id", "content"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "content": { "type": "string", "maxLength": 100000 }
      }
    },
    "response": {
      "type": "object",
      "required": ["id", "content"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "content": { "type": "string", "maxLength": 100000 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "advisory": { "const": true }
      }
    },
    "defEval": { "enum": ["open", "resolved"] },
    "egress": { "enum": ["disabled", "approved"] },
    "credentials": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "live" } } },
      "then": {
        "required": ["defEval", "egress", "credentials"],
        "properties": {
          "defEval": { "const": "resolved" },
          "egress": { "const": "approved" },
          "credentials": { "const": true }
        }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "stub" } } },
      "then": { "properties": { "credentials": { "const": false } } }
    }
  ]
}
