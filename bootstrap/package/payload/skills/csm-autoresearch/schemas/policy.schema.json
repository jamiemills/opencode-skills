{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "csm-autoresearch policies",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "mode", "hardGates", "population"],
  "properties": {
    "format": { "const": "csm-autoresearch-policy/1" },
    "mode": { "enum": ["target", "hill-climb"] },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "value"],
      "properties": {
        "operator": { "enum": ["<", "<=", ">", ">=", "="] },
        "value": { "type": "number" },
        "tolerance": { "type": "number", "minimum": 0 },
        "confidence": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "hardGates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": [
              "valid",
              "build",
              "scope",
              "regression",
              "resource",
              "sandbox",
              "hidden-validation"
            ]
          },
          "config": { "type": "object" }
        }
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "activateAfterStagnantTrials", "maxArchive"],
      "properties": {
        "enabled": { "type": "boolean" },
        "activateAfterStagnantTrials": { "type": "integer", "minimum": 1 },
        "maxArchive": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "approval": { "enum": ["none", "protected-human"] }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "target" } } },
      "then": { "required": ["target"] }
    }
  ]
}
