{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "csm-test-package/1",
  "title": "JSON-only csm-build test package handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packageId",
    "owner",
    "runId",
    "sourcePlan",
    "ledger",
    "verification",
    "replay"
  ],
  "properties": {
    "schema": { "const": "csm-test-package/1" },
    "packageId": { "type": "string", "minLength": 1 },
    "owner": { "const": "csm-make-tests" },
    "runId": { "type": "string", "minLength": 1 },
    "sourcePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planId", "taskId", "planPath", "planDigest"],
      "properties": {
        "planId": { "type": "string", "minLength": 1 },
        "taskId": { "type": "string", "pattern": "^T[0-9]{3}$" },
        "planPath": { "type": "string", "minLength": 1 },
        "planDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "terminal"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "terminal": { "type": "boolean" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "status"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "status": { "enum": ["VERIFIED", "INCOMPLETE", "BLOCKED"] }
      }
    },
    "replay": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "digest", "command"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "command": { "type": "string", "minLength": 1 }
        }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "score"],
      "properties": {
        "status": { "enum": ["verified", "stale", "missing", "unavailable"] },
        "score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "baselineId"],
      "properties": {
        "status": { "enum": ["verified", "stale", "missing", "unavailable"] },
        "baselineId": { "type": "string", "minLength": 1 }
      }
    },
    "terminal": { "type": "boolean" }
  }
}
