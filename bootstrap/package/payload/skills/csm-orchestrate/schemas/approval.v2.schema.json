{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "csm-orchestrate-approval/2",
  "title": "CSM orchestrate invocation approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "approvalId",
    "binding",
    "scope",
    "approvedDigest",
    "approvedAt",
    "expiresAt",
    "status"
  ],
  "properties": {
    "schema": { "const": "csm-orchestrate-approval/2" },
    "approvalId": { "type": "string", "pattern": "^approval-[a-z0-9][a-z0-9-]{1,127}$" },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parentRunId", "childRunId", "phaseId", "edgeId"],
      "properties": {
        "parentRunId": { "$ref": "#/$defs/runId" },
        "childRunId": { "$ref": "#/$defs/runId" },
        "phaseId": { "type": "string", "pattern": "^phase-[a-z0-9][a-z0-9-]{1,127}$" },
        "edgeId": { "type": "string", "pattern": "^edge-[a-z0-9][a-z0-9-]{1,127}$" }
      }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "approvedDigest": { "$ref": "#/$defs/digest" },
    "approvedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["approved", "pending", "consumed", "expired", "revoked", "invalid"] },
    "consumedAt": { "type": "string", "format": "date-time" },
    "revokedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "runId": { "type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{1,127}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
