{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "csm-orchestrate-child-attempt/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "attemptId",
    "logicalKey",
    "requestDigest",
    "parentRunId",
    "childRunId",
    "phaseId",
    "attempt",
    "capabilityDigest",
    "contractDigest",
    "handlerDigest",
    "receiptSchemaDigest",
    "evidenceSchemaDigest",
    "configDigest",
    "sideEffectClass",
    "state"
  ],
  "properties": {
    "schema": { "const": "csm-orchestrate-child-attempt/1" },
    "attemptId": { "type": "string", "minLength": 1 },
    "logicalKey": { "type": "string", "minLength": 1 },
    "requestDigest": { "$ref": "#/$defs/digest" },
    "parentRunId": { "$ref": "#/$defs/runId" },
    "childRunId": { "$ref": "#/$defs/runId" },
    "phaseId": { "type": "string", "pattern": "^phase-[a-z0-9][a-z0-9-]{1,127}$" },
    "attempt": { "type": "integer", "minimum": 0 },
    "capabilityDigest": { "$ref": "#/$defs/digest" },
    "contractDigest": { "$ref": "#/$defs/digest" },
    "handlerDigest": { "$ref": "#/$defs/digest" },
    "receiptSchemaDigest": { "$ref": "#/$defs/digest" },
    "evidenceSchemaDigest": { "$ref": "#/$defs/digest" },
    "configDigest": { "$ref": "#/$defs/digest" },
    "sideEffectClass": { "type": "string", "minLength": 1 },
    "dispatchIntentId": { "type": ["string", "null"] },
    "state": { "enum": ["dispatched", "terminal", "UNKNOWN"] },
    "response": {},
    "createdAt": { "type": "string" },
    "completedAt": { "type": ["string", "null"] }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "runId": { "type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{1,127}$" }
  }
}
