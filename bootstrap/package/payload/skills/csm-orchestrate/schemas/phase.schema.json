{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "csm-orchestrate-phase/1",
  "title": "CSM orchestrate immutable runtime phase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "phaseId",
    "parentPhaseId",
    "runId",
    "graphRevision",
    "insertion",
    "owner",
    "route",
    "requirementIds",
    "acceptanceSignals",
    "approvalScope",
    "idempotency",
    "remediationBudget",
    "status"
  ],
  "properties": {
    "schema": { "const": "csm-orchestrate-phase/1" },
    "phaseId": { "$ref": "#/$defs/phaseId" },
    "parentPhaseId": { "anyOf": [{ "$ref": "#/$defs/phaseId" }, { "type": "null" }] },
    "runId": { "$ref": "#/$defs/runId" },
    "graphRevision": { "type": "integer", "minimum": 1 },
    "insertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "ordinal"],
      "properties": {
        "mode": { "enum": ["initial", "append", "insert"] },
        "ordinal": { "type": "integer", "minimum": 0 },
        "insertedAfter": { "$ref": "#/$defs/phaseId" }
      }
    },
    "immutable": { "const": true },
    "order": { "type": "integer", "minimum": 0 },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "goal", "deliverables"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "deliverables": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "owner": { "type": "string", "pattern": "^csm-[a-z0-9][a-z0-9-]{1,63}$" },
    "route": { "type": "string", "pattern": "^csm-[a-z0-9][a-z0-9-]{1,63}$" },
    "routeNodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nodeId",
          "skill",
          "capabilityDigest",
          "dependencies",
          "ordering",
          "requirementIds",
          "acceptanceSignals",
          "approvalScope",
          "evidence",
          "sideEffects",
          "idempotency"
        ],
        "properties": {
          "nodeId": { "type": "string", "minLength": 1 },
          "skill": { "type": "string", "pattern": "^csm-[a-z0-9][a-z0-9-]{1,63}$" },
          "capabilityDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "ordering": { "type": "integer", "minimum": 0 },
          "parallelGroup": { "type": ["string", "null"] },
          "requirementIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/requirementId" }
          },
          "acceptanceSignals": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "approvalScope": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["schema", "kind"],
              "properties": {
                "schema": { "type": ["string", "null"] },
                "kind": { "type": "string", "minLength": 1 }
              }
            }
          },
          "sideEffects": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "idempotency": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "mode"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "mode": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/phaseId" }
    },
    "requirementIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/requirementId" }
    },
    "acceptanceSignals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "approvalScope": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema", "kind"],
        "properties": {
          "schema": { "type": ["string", "null"] },
          "kind": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sideEffects": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "mode"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["read-only", "required", "forbidden"] }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phaseId", "state", "next"],
      "properties": {
        "phaseId": { "$ref": "#/$defs/phaseId" },
        "state": { "enum": ["planned", "active", "accepted", "blocked", "failed", "incomplete"] },
        "next": { "type": "string", "minLength": 1 }
      }
    },
    "remediationBudget": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["planned", "active", "accepted", "blocked", "failed", "incomplete"] }
  },
  "$defs": {
    "phaseId": { "type": "string", "pattern": "^phase-[a-z0-9][a-z0-9-]{1,127}$" },
    "requirementId": { "type": "string", "pattern": "^req-[a-z0-9][a-z0-9-]{1,127}$" },
    "runId": { "type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{1,127}$" }
  }
}
