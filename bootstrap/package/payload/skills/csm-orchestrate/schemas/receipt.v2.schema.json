{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "csm-orchestrate-receipt/2",
  "title": "CSM orchestrate parent receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receiptId",
    "runId",
    "phaseId",
    "childReceipts",
    "approval",
    "statuses",
    "outcome",
    "idempotencyKey"
  ],
  "properties": {
    "schema": { "const": "csm-orchestrate-receipt/2" },
    "receiptId": { "type": "string", "pattern": "^receipt-[a-z0-9][a-z0-9-]{1,127}$" },
    "runId": { "type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{1,127}$" },
    "phaseId": { "type": "string", "pattern": "^phase-[a-z0-9][a-z0-9-]{1,127}$" },
    "childReceipts": {
      "type": "array",
      "items": { "$ref": "#/$defs/childReceipt" },
      "uniqueItems": true
    },
    "approval": { "$ref": "#/$defs/approval" },
    "statuses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "child", "artifact", "verification", "parent"],
      "properties": {
        "route": { "enum": ["selected", "dispatched", "blocked", "complete"] },
        "child": { "enum": ["not-started", "running", "completed", "failed", "blocked"] },
        "artifact": { "enum": ["none", "active", "completed", "failed", "blocked"] },
        "verification": { "enum": ["unverified", "incomplete", "verified", "rejected"] },
        "parent": { "enum": ["active", "verified", "incomplete", "blocked", "failed"] }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "accepted", "acceptanceRefs"],
      "properties": {
        "status": {
          "enum": ["VERIFIED", "INCOMPLETE", "BLOCKED", "FAILED", "REFUSED", "REQUIRES_REVIEW"]
        },
        "accepted": { "type": "boolean" },
        "acceptanceRefs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(ev|req)-[a-z0-9][a-z0-9-]{1,127}$" },
          "uniqueItems": true
        }
      }
    },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "childReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptId", "schema", "runId", "digest", "owner", "status"],
      "properties": {
        "receiptId": { "type": "string", "pattern": "^receipt-[a-z0-9][a-z0-9-]{1,127}$" },
        "schema": { "type": "string", "pattern": "^csm-[a-z0-9][a-z0-9-]*/[1-9][0-9]*$" },
        "runId": { "type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{1,127}$" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "owner": { "type": "string", "pattern": "^csm-[a-z0-9][a-z0-9-]{1,63}$" },
        "status": { "enum": ["completed", "failed", "blocked", "incomplete"] }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvalId", "scope", "approvedDigest", "approvedAt", "expiresAt", "status"],
      "properties": {
        "approvalId": { "type": "string", "pattern": "^approval-[a-z0-9][a-z0-9-]{1,127}$" },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "approvedDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "approvedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "status": { "enum": ["pending", "approved", "expired", "consumed", "invalid"] }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "graphRevision",
        "phaseSummaries",
        "remediationLineage",
        "reviewIds",
        "evidenceRefs",
        "acceptanceRefs",
        "childReceipts",
        "sourceLineage"
      ],
      "properties": {
        "schema": { "const": "csm-orchestrate-receipt-extension/2" },
        "graphRevision": { "type": "integer", "minimum": 1 },
        "phaseSummaries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["phaseId", "graphRevision", "gateStatus", "reviewStatus"],
            "properties": {
              "phaseId": { "type": "string" },
              "parentPhaseId": { "type": ["string", "null"] },
              "graphRevision": { "type": "integer", "minimum": 1 },
              "gateStatus": { "type": "string" },
              "reviewStatus": { "type": "string" }
            }
          }
        },
        "remediationLineage": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "reviewIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "evidenceRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "acceptanceRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "childReceipts": { "type": "array", "items": { "$ref": "#/$defs/childReceipt" } },
        "sourceLineage": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "phaseResults": { "type": "array" },
        "phaseContracts": { "type": "array" },
        "finalReview": { "type": ["object", "null"] }
      }
    }
  }
}
