{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "csm-orchestrate-requirement/2",
  "title": "CSM orchestrate requirement ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ledgerId", "requirements"],
  "properties": {
    "schema": { "const": "csm-orchestrate-requirement/2" },
    "ledgerId": { "type": "string", "pattern": "^ledger-[a-z0-9][a-z0-9-]{1,127}$" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementId", "criticality", "statement", "status", "evidenceRefs"],
      "properties": {
        "requirementId": { "type": "string", "pattern": "^req-[a-z0-9][a-z0-9-]{1,127}$" },
        "criticality": { "enum": ["critical", "important", "advisory"] },
        "statement": { "type": "string", "minLength": 1 },
        "acceptanceSignal": { "type": "string", "minLength": 1 },
        "acceptanceSignalId": { "type": "string", "pattern": "^sig-[a-z0-9][a-z0-9-]{1,127}$" },
        "acceptanceSignalIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^sig-[a-z0-9][a-z0-9-]{1,127}$" }
        },
        "acceptanceSignals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "status": {
          "enum": ["open", "in-progress", "verified", "unverified", "blocked", "waived"]
        },
        "evidenceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRef" },
          "uniqueItems": true
        },
        "waiver": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "kind", "requirementId", "status", "digest"],
      "properties": {
        "evidenceId": { "type": "string", "pattern": "^ev-[a-z0-9][a-z0-9-]{1,127}$" },
        "kind": { "enum": ["technical", "functional", "review", "acceptance", "fixture"] },
        "requirementId": { "type": "string", "pattern": "^req-[a-z0-9][a-z0-9-]{1,127}$" },
        "status": { "enum": ["available", "stale", "missing", "contradicted", "unavailable"] },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "source": { "type": "string", "minLength": 1 }
      }
    }
  }
}
