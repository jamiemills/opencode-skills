{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "csm-upload-publication/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifactId",
    "runId",
    "owner",
    "sourceRunId",
    "destination",
    "inputs",
    "confirmation",
    "snapshot",
    "binaryAcknowledgment",
    "status",
    "deployment",
    "cleanup",
    "descriptorDigest"
  ],
  "properties": {
    "schema": { "const": "csm-upload-publication/1" },
    "artifactId": { "type": "string", "pattern": "^art-[a-z0-9][a-z0-9-]{1,127}$" },
    "runId": { "type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{1,127}$" },
    "owner": { "const": "csm-upload" },
    "sourceRunId": { "type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{1,127}$" },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github", "pagesRepo", "path"],
      "properties": {
        "github": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,39}$" },
        "pagesRepo": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)[.]{2}(?:/|$))[^\\u0000]+$" }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "path", "digest", "bytes", "contentType"],
        "properties": {
          "evidenceId": { "type": "string" },
          "path": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "contentType": { "type": "string", "minLength": 1 }
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "confirmed"],
      "properties": {
        "required": { "const": true },
        "confirmed": { "type": "boolean" },
        "confirmedAt": { "type": "string", "format": "date-time" }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxFiles", "maxBytes"],
      "properties": {
        "maxFiles": { "type": "integer", "minimum": 1, "maximum": 32 },
        "maxBytes": { "type": "integer", "minimum": 1, "maximum": 67108864 }
      }
    },
    "binaryAcknowledgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "acknowledged"],
      "properties": { "required": { "type": "boolean" }, "acknowledged": { "type": "boolean" } }
    },
    "status": { "enum": ["draft", "validated", "publishing", "published", "failed", "cleanup"] },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["not-started", "pending", "published", "failed", "unknown"] },
        "url": { "type": ["string", "null"], "format": "uri" },
        "verifiedAt": { "type": "string", "format": "date-time" }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["not-needed", "pending", "complete", "failed"] },
        "path": { "type": ["string", "null"] }
      }
    },
    "descriptorDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
