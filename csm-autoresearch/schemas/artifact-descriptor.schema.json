{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "csm-autoresearch-artifact-descriptor/1",
  "title": "csm-autoresearch shared artifact descriptor adapter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "artifact", "contentType", "location", "lifecycleStatus"],
  "properties": {
    "schema": { "const": "csm-artifact/1" },
    "artifact": { "$ref": "#/$defs/artifact" },
    "contentType": { "enum": ["application/json", "application/jsonl"] },
    "location": { "type": "string", "pattern": "^(?!/)[^\\r\\n]+$" },
    "lifecycleStatus": {
      "enum": ["active", "completed", "failed", "blocked", "superseded", "quarantined"]
    },
    "sourceArtifactIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^art-[a-z0-9][a-z0-9-]{1,127}$" },
      "uniqueItems": true
    },
    "rollbackArtifactId": { "type": "string", "pattern": "^art-[a-z0-9][a-z0-9-]{1,127}$" }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "kind", "owner", "runId", "digest", "createdAt", "revision"],
      "properties": {
        "artifactId": { "type": "string", "pattern": "^art-[a-z0-9][a-z0-9-]{1,127}$" },
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,63}$" },
        "owner": { "const": "csm-autoresearch" },
        "runId": { "type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{1,127}$" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "revision": { "const": 1 }
      }
    }
  }
}
