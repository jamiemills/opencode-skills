{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "csm-autoresearch report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "runId",
    "status",
    "mode",
    "sourceMode",
    "baseline",
    "trials",
    "gates",
    "artifactRefs"
  ],
  "properties": {
    "format": { "const": "csm-autoresearch-report/1" },
    "runId": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["completed", "stopped", "blocked", "approval_pending", "promoted", "rolled_back"]
    },
    "mode": { "enum": ["target", "hill-climb"] },
    "sourceMode": { "enum": ["registered", "trusted-local", "generated"] },
    "baseline": {
      "type": "object",
      "required": ["metrics", "status"],
      "additionalProperties": false,
      "properties": {
        "metrics": { "type": "object", "additionalProperties": { "type": "number" } },
        "status": { "const": "ok" }
      }
    },
    "trials": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["candidateId", "status", "decision"],
        "additionalProperties": false,
        "properties": {
          "candidateId": { "type": "string" },
          "status": { "type": "string" },
          "decision": { "type": "string" },
          "metrics": { "type": "object" },
          "diagnostics": { "type": "array" }
        }
      }
    },
    "gates": {
      "type": "object",
      "required": ["hardPassed", "failed"],
      "additionalProperties": false,
      "properties": {
        "hardPassed": { "type": "boolean" },
        "failed": { "type": "array", "items": { "type": "string" } }
      }
    },
    "artifactRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^(?!/).+" }
    },
    "approval": { "type": "object" },
    "rollback": { "type": "object" }
  }
}
