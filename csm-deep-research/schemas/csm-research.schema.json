{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "csm-research/1",
  "title": "CSM deep research finding payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaRevision",
    "title",
    "runId",
    "sections",
    "claims",
    "references",
    "journal",
    "declaredArtifacts",
    "provenance",
    "projection"
  ],
  "properties": {
    "schema": { "const": "csm-research/1" },
    "schemaRevision": { "const": 1 },
    "artifactId": { "type": "string", "pattern": "^art-[a-z0-9][a-z0-9-]{1,127}$" },
    "runId": { "type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{1,127}$" },
    "title": { "type": "string", "minLength": 1 },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tldr",
        "executiveSummary",
        "keyFindings",
        "detailSections",
        "recommendation",
        "unverifiedClaims",
        "references",
        "processAppendix"
      ],
      "properties": {
        "tldr": { "$ref": "#/$defs/textSection" },
        "executiveSummary": { "$ref": "#/$defs/textSection" },
        "keyFindings": { "$ref": "#/$defs/textSection" },
        "detailSections": { "$ref": "#/$defs/textSection" },
        "recommendation": { "$ref": "#/$defs/textSection" },
        "unverifiedClaims": { "$ref": "#/$defs/textSection" },
        "references": { "$ref": "#/$defs/textSection" },
        "processAppendix": { "$ref": "#/$defs/textSection" }
      }
    },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" }, "uniqueItems": true },
    "references": {
      "type": "array",
      "items": { "$ref": "#/$defs/reference" },
      "uniqueItems": true
    },
    "journal": {
      "type": "array",
      "items": { "$ref": "#/$defs/journalEntry" },
      "uniqueItems": true
    },
    "declaredArtifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/declaredArtifact" },
      "uniqueItems": true
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "sectionOrder", "legacyMarkdownStatus"],
      "properties": {
        "profile": { "const": "csm-research-human/1" },
        "sectionOrder": {
          "type": "array",
          "const": [
            "tldr",
            "executiveSummary",
            "keyFindings",
            "detailSections",
            "recommendation",
            "unverifiedClaims",
            "references",
            "processAppendix"
          ]
        },
        "legacyMarkdownStatus": { "const": "history-only" }
      }
    }
  },
  "$defs": {
    "textSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "content": { "type": "string", "minLength": 1 }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimId",
        "section",
        "statement",
        "claimType",
        "verdict",
        "confidence",
        "citations"
      ],
      "properties": {
        "claimId": { "type": "string", "pattern": "^claim-[a-z0-9][a-z0-9-]{1,63}$" },
        "section": {
          "enum": ["keyFindings", "detailSections", "recommendation", "unverifiedClaims"]
        },
        "statement": { "type": "string", "minLength": 1 },
        "claimType": {
          "enum": [
            "capability",
            "mechanism",
            "condition",
            "observed-outcome",
            "projected-outcome",
            "causal",
            "recommendation"
          ]
        },
        "verdict": {
          "enum": ["supported", "partially-supported", "not-supported", "unverifiable"]
        },
        "confidence": { "enum": ["high", "medium", "low"] },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/citation" },
          "uniqueItems": true
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referenceId"],
      "properties": {
        "referenceId": { "type": "string", "pattern": "^ref-[a-z0-9][a-z0-9-]{1,63}$" },
        "locator": { "type": "string", "minLength": 1 },
        "quote": { "type": "string", "minLength": 1 }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referenceId", "url", "publisher", "retrievedAt"],
      "properties": {
        "referenceId": { "type": "string", "pattern": "^ref-[a-z0-9][a-z0-9-]{1,63}$" },
        "url": { "type": "string", "pattern": "^https?://[^\\s]+$" },
        "publisher": { "type": "string", "minLength": 1 },
        "retrievedAt": { "type": "string", "format": "date" },
        "publishedOrUpdated": { "type": "string", "minLength": 1 },
        "sourcePosture": {
          "enum": [
            "vendor-documentation",
            "vendor-reported-outcome",
            "customer-evidence",
            "independent-analysis",
            "empirical-measurement",
            "methodological-authority",
            "inference"
          ]
        }
      }
    },
    "journalEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "state", "event", "occurredAt"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "state": {
          "enum": [
            "INTAKE",
            "TRIAGE",
            "RESEARCH",
            "SYNTHESIZE",
            "CHALLENGE",
            "JUDGE",
            "REMEDIATE",
            "VERIFY",
            "SAVED",
            "BLOCKED"
          ]
        },
        "event": { "type": "string", "minLength": 1 },
        "occurredAt": { "type": "string", "format": "date-time" },
        "cycle": { "type": "integer", "minimum": 0 },
        "trigger": { "type": "string", "minLength": 1 }
      }
    },
    "declaredArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "path", "schema", "digest", "relation"],
      "properties": {
        "artifactId": { "type": "string", "pattern": "^art-[a-z0-9][a-z0-9-]{1,127}$" },
        "path": {
          "type": "string",
          "pattern": "^\\.agents/research/artifacts/[a-z0-9][a-z0-9./-]+$"
        },
        "schema": { "$ref": "#/$defs/schemaRef" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "relation": { "enum": ["supports", "derived-from", "supersedes"] }
      }
    },
    "schemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*/[1-9][0-9]*$" },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "producerVersion", "producedAt", "sourceDigests"],
      "properties": {
        "producer": { "const": "csm-deep-research" },
        "producerVersion": { "type": "string", "minLength": 1 },
        "producedAt": { "type": "string", "format": "date-time" },
        "sourceDigests": {
          "type": "array",
          "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "uniqueItems": true
        }
      }
    }
  }
}
