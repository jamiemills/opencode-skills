{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "csm-orchestrate-adversarial-review/2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "reviewId", "runId", "status", "independent", "findings", "provenance"],
  "properties": {
    "schema": { "const": "csm-orchestrate-adversarial-review/2" },
    "reviewId": { "type": "string", "pattern": "^review-[a-z0-9][a-z0-9-]{1,127}$" },
    "runId": { "type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{1,127}$" },
    "owner": { "type": "string", "pattern": "^csm-[a-z0-9][a-z0-9-]{1,63}$" },
    "phaseId": { "type": "string", "pattern": "^phase-[a-z0-9][a-z0-9-]{1,127}$" },
    "inputDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sourceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sourceRunId": { "type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{1,127}$" },
    "sourceArtifactIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^art-[a-z0-9][a-z0-9-]{1,127}$" },
      "uniqueItems": true
    },
    "status": { "enum": ["ACCEPTED", "REJECTED"] },
    "independent": { "const": true },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "reviewer", "reviewerChildRunId"],
      "properties": {
        "mode": { "enum": ["local-test-seam", "host-backed", "in-process-independent"] },
        "reviewer": { "type": "string", "minLength": 1 },
        "executor": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "pattern": "^csm-[a-z0-9][a-z0-9-]{1,63}$" },
        "reviewerChildRunId": { "type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{1,127}$" },
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifactId", "runId", "digest"],
          "properties": {
            "artifactId": { "type": "string", "minLength": 1 },
            "runId": { "type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{1,127}$" },
            "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "owner": { "type": "string", "pattern": "^csm-[a-z0-9][a-z0-9-]{1,63}$" },
            "schema": { "const": "csm-review-receipt/1" },
            "path": { "type": "string", "minLength": 1 },
            "resolution": { "type": "string", "minLength": 1 }
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifactId", "runId", "digest"],
          "properties": {
            "artifactId": { "type": "string", "minLength": 1 },
            "runId": { "type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{1,127}$" },
            "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "owner": { "type": "string", "pattern": "^csm-[a-z0-9][a-z0-9-]{1,63}$" },
            "schema": { "const": "csm-orchestrate-adversarial-review/2" },
            "path": { "type": "string", "minLength": 1 },
            "resolution": { "type": "string", "minLength": 1 }
          }
        },
        "approval": {
          "type": "object",
          "required": [
            "approvalId",
            "edgeId",
            "parentRunId",
            "reviewerChildRunId",
            "phaseId",
            "approvedDigest"
          ],
          "properties": {
            "approvalId": { "type": "string", "minLength": 1 },
            "edgeId": { "type": "string", "minLength": 1 },
            "parentRunId": { "type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{1,127}$" },
            "reviewerChildRunId": { "type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{1,127}$" },
            "phaseId": { "type": "string", "pattern": "^phase-[a-z0-9][a-z0-9-]{1,127}$" },
            "approvedDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        }
      }
    },
    "requirementCoverage": { "type": "array" },
    "evidenceEntailment": { "enum": ["supported", "failed"] },
    "artifactIdentity": { "enum": ["verified", "failed"] },
    "omissions": { "type": "array" },
    "assumptions": { "type": "array" },
    "scope": { "type": "object" },
    "staleDuplicateOutputs": { "type": "array" },
    "unsafeActions": { "type": "array" },
    "technical": { "type": "array" },
    "functional": { "type": "array" },
    "falseCompletion": { "type": "boolean" },
    "findings": { "type": "array" }
  },
  "allOf": [
    {
      "if": {
        "required": ["provenance"],
        "properties": {
          "provenance": {
            "required": ["mode"],
            "properties": { "mode": { "const": "host-backed" } }
          }
        }
      },
      "then": {
        "required": [
          "owner",
          "phaseId",
          "inputDigest",
          "sourceDigest",
          "sourceRunId",
          "sourceArtifactIds"
        ],
        "properties": { "provenance": { "required": ["owner", "receipt", "artifact", "approval"] } }
      }
    },
    {
      "if": {
        "required": ["provenance"],
        "properties": {
          "provenance": {
            "required": ["mode"],
            "properties": { "mode": { "enum": ["host-backed", "in-process-independent"] } }
          }
        }
      },
      "then": {
        "required": [
          "owner",
          "phaseId",
          "inputDigest",
          "sourceDigest",
          "sourceRunId",
          "sourceArtifactIds"
        ]
      }
    }
  ]
}
