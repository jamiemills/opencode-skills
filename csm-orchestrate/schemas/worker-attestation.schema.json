{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "csm-orchestrate-worker-attestation/1",
  "title": "CSM worker sandbox attestation",
  "description": "Periodic re-attestation snapshot for a long-lived sandbox worker. Inspections are appended on a cadence; any drift fails closed to blocked. The head is keyed/signed and anchored outside the worker trust domain so an unkeyed chain cannot be recomputed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaRevision",
    "workerId",
    "runId",
    "policyDigest",
    "imageDigest",
    "status",
    "inspections",
    "anchor"
  ],
  "properties": {
    "schema": {
      "const": "csm-orchestrate-worker-attestation/1"
    },
    "schemaRevision": {
      "const": 1
    },
    "workerId": {
      "type": "string",
      "pattern": "^worker-[a-z0-9][a-z0-9-]{1,127}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^run-[a-z0-9][a-z0-9-]{1,127}$"
    },
    "policyDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "imageDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "status": {
      "enum": ["verified", "drift", "unavailable"]
    },
    "inspections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "controlResults"],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "controlResults": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mountsEmpty",
              "rootFilesystemReadOnly",
              "capDropAll",
              "noNewPrivileges",
              "networkIsolated",
              "credentialsNone"
            ],
            "properties": {
              "mountsEmpty": {
                "type": "boolean"
              },
              "rootFilesystemReadOnly": {
                "type": "boolean"
              },
              "capDropAll": {
                "type": "boolean"
              },
              "noNewPrivileges": {
                "type": "boolean"
              },
              "networkIsolated": {
                "type": "boolean"
              },
              "credentialsNone": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "headDigest", "signedAt", "external"],
      "properties": {
        "algorithm": {
          "enum": ["hmac-sha256", "ed25519"]
        },
        "keyId": {
          "type": "string",
          "minLength": 1
        },
        "headDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "signedAt": {
          "type": "string",
          "format": "date-time"
        },
        "external": {
          "type": "boolean"
        }
      }
    }
  }
}
