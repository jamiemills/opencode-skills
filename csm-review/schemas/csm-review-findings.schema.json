{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "csm-review-findings/1",
  "title": "CSM repository review findings payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaRevision",
    "artifact",
    "source",
    "findings",
    "verificationStatus",
    "redaction",
    "sortOrder",
    "ownership"
  ],
  "properties": {
    "schema": { "enum": ["csm-review-findings/1", "csm-doctrine-findings/1"] },
    "schemaRevision": { "const": 1 },
    "artifact": { "$ref": "#/$defs/artifact" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commitSha"],
      "properties": {
        "commitSha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "repository": { "type": "string", "minLength": 1 }
      }
    },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "verificationStatus": { "$ref": "#/$defs/verificationStatus" },
    "redaction": { "$ref": "#/$defs/redaction" },
    "sortOrder": { "$ref": "#/$defs/sortOrder" },
    "ownership": { "$ref": "#/$defs/ownership" },
    "projection": { "$ref": "#/$defs/projection" }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "owner", "runId", "digest", "createdAt", "terminal"],
      "properties": {
        "artifactId": { "type": "string", "pattern": "^art-(review|doctrine)-[a-z0-9-]+$" },
        "owner": { "enum": ["csm-review", "csm-review-python"] },
        "runId": { "type": "string", "pattern": "^run-[a-z0-9-]+$" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "terminal": { "type": "boolean" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "dimension",
        "category",
        "severity",
        "confidence",
        "evidenceClass",
        "locations",
        "quotedSnippets",
        "commitSha",
        "explanation",
        "impact",
        "remediationSketch",
        "fixActions",
        "challenges",
        "dissents",
        "status",
        "statusNote",
        "sortKey"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^F-[0-9]{3,}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "dimension": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "anchorRef": { "type": ["string", "null"] },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "confidence": { "enum": ["verified", "high", "medium", "low"] },
        "evidenceClass": { "enum": ["E1", "E2", "E3", "E4"] },
        "locations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/location" } },
        "quotedSnippets": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^(?!.*(?:/home/|/Users/|[A-Za-z]:\\\\)).*$"
          }
        },
        "commitSha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "explanation": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "remediationSketch": { "type": "string", "minLength": 1 },
        "fixActions": { "type": "array", "items": { "$ref": "#/$defs/fixAction" } },
        "verification": { "anyOf": [{ "$ref": "#/$defs/verification" }, { "type": "null" }] },
        "challenges": { "type": "array", "items": { "$ref": "#/$defs/challenge" } },
        "dissents": { "type": "array", "items": { "$ref": "#/$defs/dissent" } },
        "status": { "enum": ["upheld", "downgraded", "retracted"] },
        "statusNote": { "type": "string", "minLength": 1 },
        "corroborators": {
          "type": "array",
          "items": { "type": "string", "pattern": "^agent-[a-z0-9-]+$" }
        },
        "sortKey": { "type": "string", "pattern": "^[0-4]:[0-3]:[0-3]:F-[0-9]{3,}$" },
        "cvss": {
          "type": "object",
          "additionalProperties": false,
          "required": ["score", "vector", "assumptions"],
          "properties": {
            "score": { "type": "number", "minimum": 0, "maximum": 10 },
            "vector": { "type": "string", "minLength": 1 },
            "assumptions": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "evidenceClass": { "const": "E1" } } },
          "then": {
            "required": ["verification"],
            "properties": { "verification": { "$ref": "#/$defs/verification" } }
          }
        },
        {
          "if": { "properties": { "evidenceClass": { "const": "E2" } } },
          "then": {
            "required": ["challenges"],
            "properties": { "challenges": { "minItems": 1 } }
          }
        },
        {
          "if": { "properties": { "evidenceClass": { "const": "E3" } } },
          "then": {
            "required": ["anchorRef"],
            "properties": { "anchorRef": { "type": "string", "minLength": 1 } }
          }
        },
        {
          "if": { "properties": { "severity": { "enum": ["critical", "high"] } } },
          "then": {
            "required": ["challenges"],
            "properties": { "challenges": { "minItems": 1 } }
          }
        }
      ]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/|[A-Za-z]:|\\\\)[^\n]+$" },
        "line": { "type": "integer", "minimum": 1 },
        "symbol": { "type": "string" }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["challengeId", "challenger", "verdict", "rationale", "redacted"],
      "properties": {
        "challengeId": { "type": "string", "pattern": "^challenge-[a-z0-9-]+$" },
        "challenger": { "type": "string", "pattern": "^agent-[a-z0-9-]+$" },
        "verdict": { "enum": ["agree", "downgrade", "retract", "new_finding"] },
        "rationale": { "type": "string", "minLength": 1 },
        "redacted": { "const": true }
      }
    },
    "dissent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dissentId", "author", "rationale", "redacted"],
      "properties": {
        "dissentId": { "type": "string", "pattern": "^dissent-[a-z0-9-]+$" },
        "author": { "type": "string", "pattern": "^agent-[a-z0-9-]+$" },
        "rationale": { "type": "string", "minLength": 1 },
        "redacted": { "const": true }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "command", "result", "redacted"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "result": { "type": "string", "minLength": 1 },
        "redacted": { "const": true }
      }
    },
    "fixAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "order", "action", "verification"],
      "properties": {
        "actionId": { "type": "string", "pattern": "^fix-[a-z0-9-]+$" },
        "order": { "type": "integer", "minimum": 0 },
        "action": { "type": "string", "minLength": 1 },
        "verification": { "type": "string", "minLength": 1 }
      }
    },
    "verificationStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "status", "unresolved"],
      "properties": {
        "format": { "const": "csm-verification-status/1" },
        "status": { "enum": ["VERIFIED", "INCOMPLETE", "BLOCKED"] },
        "unresolved": { "type": "array", "items": { "type": "string" } }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rules", "redactedFields"],
      "properties": {
        "status": { "const": "passed" },
        "rules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "redactedFields": { "type": "integer", "minimum": 0 }
      }
    },
    "sortOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "stable"],
      "properties": {
        "algorithm": { "const": "severity:confidence:evidenceClass:id" },
        "stable": { "const": true }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "runId", "collisionPolicy", "terminalPolicy"],
      "properties": {
        "owner": { "enum": ["csm-review", "csm-review-python"] },
        "runId": { "type": "string", "pattern": "^run-[a-z0-9-]+$" },
        "collisionPolicy": { "const": "reject-owner-mismatch-or-terminal" },
        "terminalPolicy": { "const": "immutable" },
        "supersedesArtifactId": {
          "type": "string",
          "pattern": "^art-(review|doctrine)-[a-z0-9-]+$"
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "formats"],
      "properties": {
        "authority": { "const": "json" },
        "formats": { "type": "array", "items": { "enum": ["markdown", "html"] } }
      }
    }
  }
}
