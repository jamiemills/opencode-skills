#!/usr/bin/env node
'use strict';

// Pre-commit gate (installed via scripts/install-hooks.mjs -> core.hooksPath).
// Advisory fast feedback (~0.2-3s): validates the WORKING TREE, not the index
// (partial staging may validate unstaged content — documented wart). Bypass
// with `git commit --no-verify`; the authoritative gate remains the repo's
// full check battery (CI when enabled).

import { execFileSync } from 'node:child_process';
import fs from 'node:fs';
import path from 'node:path';

const root = execFileSync('git', ['rev-parse', '--show-toplevel'], { encoding: 'utf8' }).trim();
const node = process.execPath;

function run(cmd, args, opts = {}) {
  try {
    execFileSync(cmd, args, { stdio: 'inherit', cwd: root, ...opts });
    return true;
  } catch {
    return false;
  }
}

let failed = false;

// 1. Repo-wide conformance gate (always).
if (!run(node, [path.join('scripts', 'check-suite.mjs')])) failed = true;

// 2. Boilerplate drift gate (when the sync tooling exists).
if (fs.existsSync(path.join(root, 'scripts', 'sync-skill-boilerplate.mjs'))) {
  if (!run(node, [path.join('scripts', 'sync-skill-boilerplate.mjs'), '--check'])) failed = true;
}

// 3. Syntax-check staged .mjs files.
const staged = execFileSync('git', ['diff', '--cached', '--name-only', '--diff-filter=ACM'], { encoding: 'utf8', cwd: root })
  .split('\n')
  .map((l) => l.trim())
  .filter((l) => l.endsWith('.mjs'));
for (const f of staged) {
  if (!fs.existsSync(path.join(root, f))) continue;
  if (!run(node, ['--check', f])) {
    console.error(`pre-commit: syntax check failed for ${f}`);
    failed = true;
  }
}

// 4. csm-browse skill check — only when csm-browse files are staged AND its
// dependencies are installed (check-skill requires node_modules).
const browseStaged = staged.some((f) => f.startsWith('csm-browse/'));
const browseDeps = fs.existsSync(path.join(root, 'csm-browse', 'node_modules'));
if (browseStaged && browseDeps) {
  if (!run(node, [path.join('csm-browse', 'scripts', 'check-skill.mjs')])) failed = true;
}

if (failed) {
  console.error('pre-commit: gate failed — fix the above, or bypass with `git commit --no-verify`.');
  process.exit(1);
}
process.exit(0);
